# Betroverse Next.js + MongoDB + Cloudinary Environment Variables
# Copy to .env.local for local development and set in Vercel Dashboard -> Settings -> Environment Variables

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/betroverse?retryWrites=true&w=majority
MONGODB_DB=betroverse

JWT_SECRET=change-this-to-a-long-random-secret-key
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change-this-password

# Cloudinary Media CDN (Required for fast image optimization & large video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Analytics 4 (Production Tracking)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
